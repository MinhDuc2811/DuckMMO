# SQLite for local development; PostgreSQL for shared deployments.
STUDIO_DATABASE_URL=sqlite:///./data/studio.db
# STUDIO_DATABASE_URL=postgresql+psycopg://studio:localdev@localhost:5432/studio
STUDIO_API_URL=http://127.0.0.1:8000
# Optional local API protection; set the same value for API and UI.
STUDIO_API_KEY=
# AI provider endpoint compatible with /chat/completions; include its /v1 path if required.
# Source data is sent to this configured provider during Phase 1 analysis.
STUDIO_ANALYSIS_BASE_URL=
STUDIO_ANALYSIS_MODEL=
STUDIO_ANALYSIS_API_KEY=
# Local generated voice, images, subtitles and MP4 files.
STUDIO_ARTIFACT_DIR=data/artifacts

# Optional declarative JSON catalog; refreshed before each new render, never executable templates.
STUDIO_STYLE_CATALOG_URL=

# Optional YouTube OAuth (upload + analytics); never use the Gemini API key here.
STUDIO_YOUTUBE_CLIENT_ID=
STUDIO_YOUTUBE_CLIENT_SECRET=
STUDIO_YOUTUBE_REFRESH_TOKEN=

# Local media limits; bytes, seconds, and FFmpeg thread count.
STUDIO_MEDIA_UPLOAD_MAX_BYTES=100000000
STUDIO_MEDIA_STORAGE_MAX_BYTES=10000000000
STUDIO_MEDIA_MIN_FREE_BYTES=500000000
STUDIO_MEDIA_MAX_DURATION=120
STUDIO_RENDER_MAX_DURATION=600
STUDIO_FFMPEG_THREADS=2
